# Campus2Air — Local Development Environment Variables
# Copy this file to .env and fill in your values.
# .env is loaded automatically when running python app.py locally.

# ── Flask ────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=change-me-to-a-random-secret

# ── Database ─────────────────────────────────────────────────────────────────
# Leave DB_ENGINE as "sqlite" for local dev — no extra setup needed.
DB_ENGINE=sqlite
# DATABASE_PATH=carpool.db   # default; change if you want a different location

# ── MySQL (production / optional for local) ──────────────────────────────────
# Only needed if DB_ENGINE=mysql
# MYSQL_HOST=your-mysql-host
# MYSQL_USER=your-mysql-user
# MYSQL_PASSWORD=your-mysql-password
# MYSQL_DATABASE=carpool
# MYSQL_PORT=3306
# MYSQL_SSL=false
# MYSQL_CONNECT_TIMEOUT=2
# MYSQL_READ_TIMEOUT=10
# MYSQL_WRITE_TIMEOUT=10
# MYSQL_RETRY_COOLDOWN_SECONDS=600
# If MySQL is unreachable: 1 = quietly use local SQLite (default locally),
# 0 = return "temporarily unavailable" errors (default on Vercel, where SQLite
# data in /tmp would be lost).
# ALLOW_SQLITE_FALLBACK=1

# ── Admin panel (disabled unless one of these is set) ────────────────────────
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=   # preferred: output of werkzeug.security.generate_password_hash
# ADMIN_PASSWORD=        # plain-text alternative, hashed at startup

# ── Legal ─────────────────────────────────────────────────────────────────────
# Shown in the Terms for legal notices and arbitration opt-outs.
# LEGAL_CONTACT_EMAIL=campus2air.legal@example.com

# ── Local debugging ──────────────────────────────────────────────────────────
# FLASK_DEBUG=1   # Werkzeug debugger for `python app.py` (binds to 127.0.0.1)

# ── Local dev notes ──────────────────────────────────────────────────────────
# 1. Run: pip install -r requirements.txt
# 2. Run: python app.py   →  http://localhost:8000
# 3. For Google Sign-In locally, add "localhost" to Firebase authorized domains:
#    Firebase Console → Authentication → Settings → Authorized domains → Add domain
